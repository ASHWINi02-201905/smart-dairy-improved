# Copy to .env (never commit real values)
DAIRY_DB=dairy.db
APP_SECRET=change-me-long-random          # signs customer download tokens
OWNER_API_KEY=change-me-long-random       # owner-only HTTP endpoints
OWNER_PHONES=919999999999                 # comma separated, country code, no +
BUSINESS_NAME=Daily Dairy Needs
BUSINESS_CONTACT=Phone / address
WA_TOKEN=                                 # permanent access token (Meta system user)
WA_PHONE_ID=                              # WhatsApp phone number ID
WA_APP_SECRET=                            # Meta app secret (webhook signature check)
WA_VERIFY_TOKEN=change-me                 # you choose; same value in Meta dashboard
WA_API_VERSION=v20.0
WA_TPL_STATEMENT=monthly_statement        # approved template: {{1}} name {{2}} period {{3}} closing balance
WA_TPL_REMINDER=payment_reminder          # approved template: {{1}} name {{2}} amount due
